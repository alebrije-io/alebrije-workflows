{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://alebrije.io/schemas/commerce.product.upserted.v1.json",
  "title": "commerce.product.upserted v1",
  "description": "Alta o cambio de un producto (espejo en catalog, D19.3). Productor: alebrije-adapt-wordpress. ADR-186, contrato v1 (alebrije-adapt-wordpress/docs/CONTRATO-v1.md).",
  "allOf": [
    {
      "$ref": "https://alebrije.io/schemas/envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "commerce.product.upserted"
        },
        "data": {
          "type": "object",
          "required": [
            "site_id",
            "source",
            "origin",
            "occurred_at",
            "product"
          ],
          "properties": {
            "site_id": {
              "type": "string",
              "format": "uuid",
              "description": "Sitio de WordPress que originó el evento (lo genera svc-auth al conectar)."
            },
            "source": {
              "type": "string",
              "enum": [
                "woocommerce",
                "wordpress"
              ],
              "description": "woocommerce (webhook de la tienda) o wordpress (evento propio del plugin); contrato v1 §6."
            },
            "origin": {
              "type": "string",
              "enum": [
                "live",
                "reconcile",
                "import"
              ],
              "description": "live = en vivo; reconcile = lo recuperó el reconciliador; import = primera carga. Con import no corre nada automático (ADR-186 D19.6)."
            },
            "occurred_at": {
              "type": "string",
              "format": "date-time",
              "description": "Cuándo pasó en el sitio, en GMT."
            },
            "messaging": {
              "type": "object",
              "description": "Si de este evento puede salir un mensaje (contrato §6). Cada consumidor manda solo si allowed y su pieza son true.",
              "properties": {
                "allowed": {
                  "type": "boolean",
                  "description": "false si el sitio tiene los mensajes apagados, está frenado, en cuarentena o en modo de prueba con un teléfono que no es de prueba."
                },
                "test_mode": {
                  "type": "boolean"
                },
                "pieces": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "description": "Interruptor de cada pieza que puede mandar (notifications.order_updates, cadences.abandoned_cart, cadences.review_request, rewards.stamps)."
                }
              },
              "required": [
                "allowed",
                "pieces"
              ],
              "additionalProperties": true
            },
            "product": {
              "type": "object",
              "required": [
                "product_id",
                "name",
                "currency",
                "status"
              ],
              "properties": {
                "product_id": {
                  "type": "integer",
                  "description": "Id del producto en la tienda."
                },
                "variation_id": {
                  "type": "integer"
                },
                "sku": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": "string",
                  "maxLength": 500,
                  "description": "Nombre visible del producto."
                },
                "status": {
                  "type": "string",
                  "description": "Estado de publicación en WordPress (publish, draft, private…)."
                },
                "price": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]{1,6})?$",
                      "description": "Monto en texto decimal, nunca float."
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "regular_price": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]{1,6})?$",
                      "description": "Monto en texto decimal, nunca float."
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sale_price": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]{1,6})?$",
                      "description": "Monto en texto decimal, nunca float."
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$",
                  "description": "Moneda ISO-4217 del precio."
                },
                "stock_status": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "stock_quantity": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "permalink": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "image_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": true,
              "description": "Producto o variación tal como lo muestra la tienda."
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
