{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://alebrije.io/schemas/crm.contact.order_updates_opted_out.v1.json",
  "title": "crm.contact.order_updates_opted_out v1",
  "description": "Un contacto dio de baja los avisos del pedido. Productor: alebrije-mod-crm-go (outbox). ADR-186, contrato v1 (alebrije-adapt-wordpress/docs/CONTRATO-v1.md).",
  "allOf": [
    {
      "$ref": "https://alebrije.io/schemas/envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "crm.contact.order_updates_opted_out"
        },
        "data": {
          "type": "object",
          "required": [
            "contact_id",
            "phone"
          ],
          "properties": {
            "contact_id": {
              "type": "string",
              "format": "uuid"
            },
            "tenant_id": {
              "type": "string",
              "format": "uuid"
            },
            "context_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "phone": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
