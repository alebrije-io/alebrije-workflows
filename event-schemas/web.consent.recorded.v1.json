{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://alebrije.io/schemas/web.consent.recorded.v1.json",
  "title": "web.consent.recorded v1",
  "description": "Un consentimiento con su evidencia (D15.6, D19.8). Nunca revierte una baja (contrato §10). Productor: alebrije-adapt-wordpress. ADR-186, contrato v1 (alebrije-adapt-wordpress/docs/CONTRATO-v1.md).",
  "allOf": [
    {
      "$ref": "https://alebrije.io/schemas/envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "web.consent.recorded"
        },
        "data": {
          "type": "object",
          "required": [
            "site_id",
            "source",
            "origin",
            "occurred_at",
            "contact",
            "consent"
          ],
          "properties": {
            "site_id": {
              "type": "string",
              "format": "uuid",
              "description": "Sitio de WordPress que originó el evento (lo genera svc-auth al conectar)."
            },
            "source": {
              "type": "string",
              "enum": [
                "woocommerce",
                "wordpress"
              ]
            },
            "origin": {
              "type": "string",
              "enum": [
                "live",
                "reconcile",
                "import"
              ],
              "description": "live = en vivo; reconcile = lo recuperó el reconciliador; import = primera carga. Con import no corre nada automático (ADR-186 D19.6)."
            },
            "occurred_at": {
              "type": "string",
              "format": "date-time",
              "description": "Cuándo pasó en el sitio, en GMT."
            },
            "messaging": {
              "type": "object",
              "description": "Si de este evento puede salir un mensaje (contrato §6). Cada consumidor manda solo si allowed y su pieza son true.",
              "properties": {
                "allowed": {
                  "type": "boolean"
                },
                "test_mode": {
                  "type": "boolean"
                },
                "pieces": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "boolean"
                  }
                }
              },
              "required": [
                "allowed",
                "pieces"
              ],
              "additionalProperties": true
            },
            "contact": {
              "type": "object",
              "description": "Contacto admitido: teléfono válido por ADR-142 con el país del pedido (ADR-186 D7 y D19.9).",
              "required": [
                "phone_e164"
              ],
              "properties": {
                "phone_e164": {
                  "type": "string",
                  "pattern": "^\\+[1-9][0-9]{7,14}$"
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 200
                },
                "email": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 254
                },
                "country": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[A-Z]{2}$"
                }
              },
              "additionalProperties": true
            },
            "consent": {
              "type": "object",
              "required": [
                "permission",
                "granted",
                "text",
                "captured_at",
                "source"
              ],
              "properties": {
                "permission": {
                  "type": "string",
                  "enum": [
                    "order_updates",
                    "marketing"
                  ]
                },
                "granted": {
                  "type": "boolean"
                },
                "text": {
                  "type": "string",
                  "maxLength": 1000
                },
                "page_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "captured_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "source_event_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "checkout",
                    "cart",
                    "form",
                    "order"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
