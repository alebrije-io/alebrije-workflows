{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://alebrije.io/schemas/commerce.review.created.v1.json",
  "title": "commerce.review.created v1",
  "description": "Reseña de producto publicada en la tienda. Productor: alebrije-adapt-wordpress. ADR-186, contrato v1 (alebrije-adapt-wordpress/docs/CONTRATO-v1.md).",
  "allOf": [
    {
      "$ref": "https://alebrije.io/schemas/envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "commerce.review.created"
        },
        "data": {
          "type": "object",
          "required": [
            "site_id",
            "source",
            "origin",
            "occurred_at",
            "review"
          ],
          "properties": {
            "site_id": {
              "type": "string",
              "format": "uuid",
              "description": "Sitio de WordPress que originó el evento (lo genera svc-auth al conectar)."
            },
            "source": {
              "type": "string",
              "enum": [
                "woocommerce",
                "wordpress"
              ]
            },
            "origin": {
              "type": "string",
              "enum": [
                "live",
                "reconcile",
                "import"
              ],
              "description": "live = en vivo; reconcile = lo recuperó el reconciliador; import = primera carga. Con import no corre nada automático (ADR-186 D19.6)."
            },
            "occurred_at": {
              "type": "string",
              "format": "date-time",
              "description": "Cuándo pasó en el sitio, en GMT."
            },
            "messaging": {
              "type": "object",
              "description": "Si de este evento puede salir un mensaje (contrato §6). Cada consumidor manda solo si allowed y su pieza son true.",
              "properties": {
                "allowed": {
                  "type": "boolean"
                },
                "test_mode": {
                  "type": "boolean"
                },
                "pieces": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "boolean"
                  }
                }
              },
              "required": [
                "allowed",
                "pieces"
              ],
              "additionalProperties": true
            },
            "review": {
              "type": "object",
              "required": [
                "review_id",
                "product_id",
                "rating"
              ],
              "properties": {
                "review_id": {
                  "type": "integer"
                },
                "product_id": {
                  "type": "integer"
                },
                "rating": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "text": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "verified": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            },
            "contact": {
              "type": "object",
              "description": "Contacto admitido: teléfono válido por ADR-142 con el país del pedido (ADR-186 D7 y D19.9).",
              "required": [
                "phone_e164"
              ],
              "properties": {
                "phone_e164": {
                  "type": "string",
                  "pattern": "^\\+[1-9][0-9]{7,14}$"
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 200
                },
                "email": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 254
                },
                "country": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[A-Z]{2}$"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
